DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_USE_X_FORWARDED_HOST=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

SMART360_APP_VERSION=1.0.0
SMART360_APP_DOMAIN=localhost
PORT=8000
WEB_PORT=8000

USE_SQLITE=True
# Para usar PostgreSQL no development, defina USE_SQLITE=False e configure:
# DB_ENGINE=postgresql
# POSTGRES_DB=smart360
# POSTGRES_USER=smart360
# POSTGRES_PASSWORD=smart360
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_EXPOSE_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_EXPOSE_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_LOG_LEVEL=info
CELERY_QUEUES=default
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler

RUN_MIGRATIONS_ON_START=1
RUN_COLLECTSTATIC_ON_START=1
RUN_BOOTSTRAP_ON_START=0
BOOTSTRAP_DEMO_PASSWORD=admin123!
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@smart360.local

API_PAGE_SIZE=25
